@model TaskManager.Web.Models.EditTaskViewModel

@{
    ViewData["Title"] = "Editar tarea";
    @* Categorías precargadas desde el controlador *@
    var categories = ViewData["Categories"] as IEnumerable<CategoryItemViewModel>;
}

<h1>Editar tarea</h1>

<form asp-action="Edit" method="post">


    <div asp-validation-summary="All" class="text-danger"></div>

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label class="form-label">Título</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Categoría</label>
        <select asp-for="CategoryId" class="form-select">
            <option value="">Seleccione una categoría</option>
            @if (categories != null && categories.Any())
            {
                @* Opciones construidas desde las categorías precargadas *@
                foreach (var cat in categories)
                {
                    var value = cat.Id != 0 ? cat.Id : cat.CategoryId;
                    var name = !string.IsNullOrWhiteSpace(cat.Name) ? cat.Name : cat.CategoryName;
                    var selected = Model.CategoryId == value;
                    if (selected)
                    {
                        <option value="@value" selected="selected">@name</option>
                    }
                    else
                    {
                        <option value="@value">@name</option>
                    }
                }
            }
            else
            {
                <option value="">No hay categorías disponibles</option>
            }
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Step</label>
        <input asp-for="Step" type="number" class="form-control" />
        <span asp-validation-for="Step" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Completado</label>
        <input asp-for="IsCompleted" type="checkbox" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
